{
  "name": "yuki-computer-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.js",
    "pretest": "npm run build:ui",
    "test": "node --test test/*.test.js test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "build:ui": "vite build",
    "test:live": "node scripts/live-test.js",
    "test:permissions-live": "node scripts/permissions-live-test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-diff-view": "3.3.3",
    "lucide-react": "1.47.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-tabs": "1.1.21"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
